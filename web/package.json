{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "prisma generate && next build",
    "start": "prisma db push --skip-generate --accept-data-loss && next start -p ${PORT:-3000}",
    "lint": "eslint",
    "worker": "tsx --env-file=.env worker/index.ts",
    "worker:prod": "tsx worker/index.ts",
    "postinstall": "prisma generate",
    "seed:words": "tsx --env-file=.env scripts/seed-words.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "viem": "^2.56.3",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}